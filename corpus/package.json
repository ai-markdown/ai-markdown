{
  "name": "@bench/corpus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The repository's single authoritative markdown corpus. Consumed by the benchmark apps, the engine fixtures and both story sets.",
  "scripts": {
    "generate:math": "node scripts/generate-math.mjs",
    "validate": "node --experimental-strip-types --no-warnings scripts/validate.mjs",
    "typecheck": "tsc --noEmit",
    "emit": "node --experimental-strip-types --no-warnings scripts/emit.mjs"
  },
  "devDependencies": {
    "@ai-markdown/engine": "workspace:*",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.1",
    "katex": "^0.16.25",
    "mermaid": "^11.17.2",
    "rehype-sanitize": "^6.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^6.0.3",
    "unified": "^11.0.5"
  }
}
