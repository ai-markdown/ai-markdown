node_modules/
.vitest/
dist/
storybook-static/
.stryker-tmp/
**/reports/mutation/

*.log
*.tsbuildinfo

.DS_Store

.claude/*.local.*
# Local agent worktrees and session data are never release sources.
/.claude/worktrees/
# Local tool state that only `.git/info/exclude` used to hide — a fresh
# clone running the same tooling would otherwise see them in `git status`.
**/.claude/scheduled_tasks.lock
**/.impeccable/
.soak-logs/
.soak-state/

# Benchmark run output — one JSON per run, kept locally until the baseline
# format settles. Committing them before then would bake a schema nobody has
# had to read twice yet.
benchmarks/results/

# Local review notes must stay out of the repository.
/docs/review/
/docs/reviews/

# Internal planning, agent state, and execution records are local only.
/.local-notes/
/.orca/
/docs/plan/
/docs/plans/

# Starlight cache and content generated from canonical repository Markdown.
apps/docs/.astro/
apps/docs/src/content/docs/

_site/
