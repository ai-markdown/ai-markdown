{
  "name": "@ai-markdown/vue",
  "version": "3.2.2",
  "description": "Vue 3 Markdown rendering, document coordination and streaming composables for ai-markdown.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "components"
  ],
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "development": {
        "import": "./dist/index.dev.js",
        "require": "./dist/index.dev.cjs"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css",
    "./components": {
      "types": {
        "import": "./dist/components/index.d.ts",
        "require": "./dist/components/index.d.cts"
      },
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.cjs"
    },
    "./components/code": {
      "types": {
        "import": "./dist/components/code.d.ts",
        "require": "./dist/components/code.d.cts"
      },
      "import": "./dist/components/code.js",
      "require": "./dist/components/code.cjs"
    },
    "./components/code/plain": {
      "types": {
        "import": "./dist/components/code/plain.d.ts",
        "require": "./dist/components/code/plain.d.cts"
      },
      "import": "./dist/components/code/plain.js",
      "require": "./dist/components/code/plain.cjs"
    },
    "./components/image": {
      "types": {
        "import": "./dist/components/image.d.ts",
        "require": "./dist/components/image.d.cts"
      },
      "import": "./dist/components/image.js",
      "require": "./dist/components/image.cjs"
    },
    "./components/table": {
      "types": {
        "import": "./dist/components/table.d.ts",
        "require": "./dist/components/table.d.cts"
      },
      "import": "./dist/components/table.js",
      "require": "./dist/components/table.cjs"
    },
    "./components/styles.css": "./dist/components/styles.css"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup && node scripts/assert-dist.mjs && node ../../scripts/copy-component-styles.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest --run"
  },
  "dependencies": {
    "@ai-markdown/core": "workspace:*",
    "@ai-markdown/engine": "workspace:*",
    "@types/hast": "^3.0.5",
    "unist-util-visit": "^5.1.0",
    "property-information": "^7.2.0",
    "@ai-markdown/code-language-detector": "workspace:^"
  },
  "devDependencies": {
    "vue": "^3.5.0",
    "@vue/server-renderer": "^3.5.0",
    "@ai-markdown/react": "workspace:*",
    "react": "^19",
    "react-dom": "^19",
    "@types/node": "^25.9.6",
    "@ai-markdown/storybook-kit": "workspace:*",
    "@storybook/vue3-vite": "10.6.0",
    "mermaid": "^11.17.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-markdown/ai-markdown.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/ai-markdown/ai-markdown/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/ai-markdown/ai-markdown/issues"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "katex": "^0.16 || ^0.17",
    "mermaid": "^11.17.2"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    }
  },
  "typesVersions": {
    "*": {
      "components": [
        "./dist/components/index.d.ts"
      ],
      "components/code": [
        "./dist/components/code.d.ts"
      ],
      "components/code/plain": [
        "./dist/components/code/plain.d.ts"
      ],
      "components/image": [
        "./dist/components/image.d.ts"
      ],
      "components/table": [
        "./dist/components/table.d.ts"
      ]
    }
  }
}
