{
  "name": "@ai-markdown/react-mantine",
  "version": "3.5.0",
  "description": "Mantine UI integration for ai-markdown React: typography, code highlighting and Mermaid diagrams.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "author": "Brian Lee <aiephoenixbl@gmail.com> (https://github.com/AIEPhoenix)",
  "homepage": "https://github.com/ai-markdown/ai-markdown/tree/main/packages/react-mantine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-markdown/ai-markdown.git",
    "directory": "packages/react-mantine"
  },
  "bugs": {
    "url": "https://github.com/ai-markdown/ai-markdown/issues"
  },
  "keywords": [
    "react",
    "react-component",
    "markdown",
    "markdown-renderer",
    "ai",
    "llm",
    "chat",
    "streaming",
    "mantine",
    "mantine-ui",
    "katex",
    "latex",
    "mermaid",
    "syntax-highlighting",
    "highlight.js",
    "code-highlight",
    "typescript"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "components",
    "independent"
  ],
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json",
    "./components": {
      "types": {
        "import": "./dist/components.d.ts",
        "require": "./dist/components.d.cts"
      },
      "import": "./dist/components.js",
      "require": "./dist/components.cjs"
    },
    "./components/code/independent": {
      "types": {
        "import": "./dist/components/code/independent.d.ts",
        "require": "./dist/components/code/independent.d.cts"
      },
      "import": "./dist/components/code/independent.js",
      "require": "./dist/components/code/independent.cjs"
    },
    "./independent": {
      "types": {
        "import": "./dist/independent.d.ts",
        "require": "./dist/independent.d.cts"
      },
      "import": "./dist/independent.js",
      "require": "./dist/independent.cjs"
    }
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/strip-declaration-map-comments.mjs && node scripts/assert-dist-clean.mjs",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@ai-markdown/react": "^3.5.0",
    "@mantine/code-highlight": "^9.0.0",
    "@mantine/core": "^9.0.0",
    "highlight.js": "^11.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "mermaid": "^11.17.2"
  },
  "peerDependenciesMeta": {
    "highlight.js": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    }
  },
  "dependencies": {
    "@ai-markdown/code-language-detector": "workspace:^",
    "@ai-markdown/core": "workspace:*"
  },
  "devDependencies": {
    "@ai-markdown/react": "workspace:*",
    "@ai-markdown/storybook-kit": "workspace:*",
    "@mantine/code-highlight": "^9.7.4",
    "@mantine/core": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@tsdown/css": "0.23.0",
    "@types/node": "^25.9.9",
    "autoprefixer": "^10.6.1",
    "highlight.js": "^11.11.2",
    "postcss": "^8.5.29",
    "sass-embedded": "^1.105.1",
    "mermaid": "^11.17.2"
  },
  "typesVersions": {
    "*": {
      "components": [
        "./dist/components.d.ts"
      ],
      "components/code/independent": [
        "./dist/components/code/independent.d.ts"
      ],
      "independent": [
        "./dist/independent.d.ts"
      ]
    }
  }
}
