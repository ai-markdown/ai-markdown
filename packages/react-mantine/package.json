{
  "name": "@ai-markdown/react-mantine",
  "version": "3.1.0",
  "description": "Mantine UI integration for ai-markdown React: typography, code highlighting and Mermaid diagrams.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "author": "Brian Lee <aiephoenixbl@gmail.com> (https://github.com/AIEPhoenix)",
  "homepage": "https://github.com/ai-markdown/ai-markdown/tree/main/packages/react-mantine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-markdown/ai-markdown.git",
    "directory": "packages/react-mantine"
  },
  "bugs": {
    "url": "https://github.com/ai-markdown/ai-markdown/issues"
  },
  "keywords": [
    "react",
    "react-component",
    "markdown",
    "markdown-renderer",
    "ai",
    "llm",
    "chat",
    "streaming",
    "mantine",
    "mantine-ui",
    "katex",
    "latex",
    "mermaid",
    "syntax-highlighting",
    "highlight.js",
    "code-highlight",
    "typescript"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/assert-dist-clean.mjs",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@ai-markdown/react": "^3.1.0",
    "@mantine/code-highlight": "^9.0.0",
    "@mantine/core": "^9.0.0",
    "highlight.js": "^11.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "highlight.js": {
      "optional": true
    }
  },
  "dependencies": {
    "mermaid": "^11.17.2"
  },
  "devDependencies": {
    "@ai-markdown/react": "workspace:*",
    "@mantine/code-highlight": "^9.6.0",
    "@mantine/core": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@types/node": "^25.9.5",
    "autoprefixer": "^10.5.5",
    "esbuild-sass-plugin": "^3.7.0",
    "highlight.js": "^11.11.2",
    "postcss": "^8.5.28",
    "tsup": "^8.5.1",
    "@ai-markdown/storybook-kit": "workspace:*"
  }
}
