{
  "name": "@ai-markdown/core",
  "version": "3.1.0",
  "description": "Framework-independent pipeline sessions, block planning, cross-chunk contributions and streaming coordination for ai-markdown adapters.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "development": {
        "import": "./dist/index.dev.js",
        "require": "./dist/index.dev.cjs"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup && node scripts/assert-boundary.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest --run"
  },
  "dependencies": {
    "@ai-markdown/engine": "workspace:*",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.6",
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "remark-squeeze-paragraphs": "^6.0.0",
    "remark-remove-comments": "^1.1.1",
    "@ai-markdown/rehype-raw": "7.0.3",
    "rehype-sanitize": "^6.0.0",
    "vfile": "^6.0.3",
    "fast-check": "^4.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-markdown/ai-markdown.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ai-markdown/ai-markdown/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/ai-markdown/ai-markdown/issues"
  }
}
