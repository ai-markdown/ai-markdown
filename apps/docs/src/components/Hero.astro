---
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
const { entry, locale } = Astro.locals.starlightRoute;
const chinese = locale === 'zh-cn';
const localizedBase = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${chinese ? 'zh-cn/' : ''}`;
const home = entry.data.template === 'splash' && entry.id !== '404';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

{home ? (
  <section class="brand-hero" aria-labelledby="_top">
    <div class="hero-copy">
      <p class="eyebrow">{chinese ? "开源 · REACT / VUE MARKDOWN" : "OPEN SOURCE \u00b7 REACT + VUE"}</p>
      <h1 id="_top" data-page-title>{chinese ? "让 AI 回答，" : "Markdown for AI,"}<br /><span>{chinese ? "边生成边呈现" : "built for the stream."}</span></h1>
      <p class="hero-tagline">{chinese ? "为 React 和 Vue 应用呈现持续生成的 Markdown。" : "From the first token to the final footnote."}</p>
      <p class="hero-description">{chinese ? "从流式文本到数学公式与中文排版，再通过 Mantine 或自定义组件接入代码高亮。" : "Rich content, incremental streaming and thoughtful multilingual typography. One shared foundation for your interface."}</p>
      <div class="hero-actions">
        <a class="get-started" href={`${localizedBase}docs/guides/getting-started/`}>{chinese ? "快速开始 " : "Get started "}<span aria-hidden="true">↗</span></a>
        <a class="read-docs" href={`${localizedBase}docs/`}>{chinese ? "查看文档 " : "Read the docs "}<span aria-hidden="true">→</span></a>
      </div>
      <p class="hero-topics">{chinese ? "流式渲染 " : "STREAMING "}<span>/</span>{chinese ? " 数学公式 " : " MATH "}<span>/</span>{chinese ? " 中文排版" : " MULTILINGUAL"}</p>
    </div>
    <div class="hero-art">
      <img src={`${base}brand/organization-mark.png`} width="460" height="460" alt={chinese ? "AI Markdown 折纸 m 标志" : "AI Markdown folded-paper m logo"} fetchpriority="high" />
    </div>
  </section>
) : <DefaultHero />}

<style>
.brand-hero {
  display: grid;
  grid-template-columns: 1.25fr 0.85fr;
  align-items: center;
  gap: 1rem;
  margin-block: 1.5rem 2rem;
  padding: clamp(1.75rem, 4vw, 3.5rem);
  border-radius: 1.5rem;
  background: #0a2035;
  color: #f6f8f7;
  overflow: hidden;
}
.eyebrow {
  font: 500 0.75rem var(--sl-font-mono);
  letter-spacing: 0.12em;
  color: #91cabb;
  margin-bottom: 1.75rem;
}
h1 {
  color: #f6f8f7;
  font-size: clamp(2.35rem, 4.8vw, 4rem);
  line-height: 1.1;
  letter-spacing: -0.055em;
  font-weight: 650;
}
h1 span {
  color: #a4dfcb;
}
.hero-tagline {
  font-size: 1.2rem;
  font-weight: 500;
  margin-top: 1.75rem;
  color: #e2eee9;
}
.hero-description {
  font-size: 1rem;
  line-height: 1.8;
  color: #aac3d0;
  max-width: 32rem;
  margin-top: 0.75rem;
}
.hero-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 2rem;
}
.hero-actions a {
  display: inline-flex;
  align-items: center;
  gap: 1.5rem;
  padding: 0.8rem 1.25rem;
  text-decoration: none;
  font-size: 1rem;
  font-weight: 600;
  border-radius: 0.45rem;
}
.get-started {
  background: #a4dfcb;
  color: #0a2035;
}
.get-started:hover {
  background: #c0f1df;
}
.read-docs {
  color: #edf5f3;
  border: 1px solid #476577;
}
.read-docs:hover {
  border-color: #a4dfcb;
}
.hero-topics {
  display: flex;
  gap: 0.7rem;
  flex-wrap: wrap;
  margin-top: 2.75rem;
  font: 0.75rem var(--sl-font-mono);
  letter-spacing: 0.12em;
  color: #93b9bd;
}
.hero-topics span {
  color: #52798b;
}
.hero-art {
  min-width: 0;
}
.hero-art img {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 1rem;
}
@media (max-width: 50rem) {
  .brand-hero {
    grid-template-columns: 1fr;
    position: relative;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
  }
  .hero-art {
    max-width: 18rem;
    margin-inline: auto;
  }
  .hero-topics {
    margin-top: 1.75rem;
  }
}
</style>
