---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';
const chinese = Astro.props.chinese === true;
const copy: Record<string, string> = {
  "AI Markdown — Markdown for streaming interfaces": "AI Markdown — 适用于流式界面的 Markdown 渲染库",
  "Render rich Markdown in React and Vue. Built for streaming AI responses, with a shared engine and flexible framework integrations.": "在 React 和 Vue 中渲染 Markdown。支持流式内容追加，可通过 Mantine 或自定义组件接入代码高亮，支持数学公式与中文排版。",
  "Render streaming Markdown in React and Vue. GFM, math and multilingual text, with your own components or Mantine for code highlighting and diagrams.": "在 React 和 Vue 中呈现持续生成的 Markdown。支持 GFM、数学公式与中文排版，可用自己的组件或 Mantine 接入代码高亮与图表。",
  "Get started": "快速开始",
  "Try the examples": "体验交互示例",
  "01 / FROM TEXT TO INTERFACE": "01 / 从文本到界面",
  "One string. A growing response.": "一条消息，持续呈现",
  "Append incoming text to one string and pass it to your renderer. Your application handles the connection; AI Markdown handles the content.": "把收到的文本追加到同一个字符串，再交给渲染组件。应用负责网络连接，AI Markdown 负责内容呈现。",
  "Explore streaming →": "了解流式渲染 →",
  "02 / CHOOSE YOUR STARTING POINT": "02 / 选择你的框架",
  "One engine. Your framework.": "同一套解析，适配你的框架",
  "Components, hooks and custom renderers that fit your application.": "提供组件、Hooks 与自定义渲染能力，方便接入现有应用。",
  "React quick start →": "开始使用 React →",
  "Reactive props, scoped slots and composables for Vue applications.": "为 Vue 应用提供响应式属性、作用域插槽和组合式函数。",
  "Vue quick start →": "开始使用 Vue →",
  "Theme-aware typography, highlighted code and Mermaid diagrams.": "支持 Mantine 主题排版、代码语法高亮与 Mermaid 图表。",
  "Mantine quick start →": "开始使用 Mantine →",
  "ai-markdown · From the first token to the final footnote.": "ai-markdown · 面向流式界面的 Markdown 渲染库",
  "Meet the project ↗": "查看开源项目 ↗"
};
const t = (value: string) => chinese ? (copy[value] ?? value) : value;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = `${base}${chinese ? 'zh-cn/' : ''}docs/`;
const reactExample = `import AIMarkdown, {
  AIMarkdownStreamingCursor,
} from '@ai-markdown/react';
import '@ai-markdown/react/typography/default.css';
import 'katex/dist/katex.min.css';

type Props = { text: string; streaming: boolean };

export function Message({ text, streaming }: Props) {
  return (
    <AIMarkdown
      content={text}
      streaming={streaming}
      streamingCursor={AIMarkdownStreamingCursor}
    />
  );
}`;
const vueExample = `<script setup lang="ts">
import AIMarkdown from '@ai-markdown/vue';
import '@ai-markdown/vue/styles.css';
import 'katex/dist/katex.min.css';

defineProps<{ text: string; streaming: boolean }>();
</script>

<template>
  <AIMarkdown :content="text" :streaming="streaming" />
</template>`;

---

<StarlightPage frontmatter={{
  title: t("AI Markdown \u2014 Markdown for streaming interfaces"),
  description: t("Render rich Markdown in React and Vue. Built for streaming AI responses, with a shared engine and flexible framework integrations."),
  template: 'splash',
  editUrl: false,
  lastUpdated: false,
  pagination: false,
  pagefind: false,
  hero: {
    title: chinese ? "让 AI 回答，\n边生成边呈现" : "Markdown for AI,\nbuilt for the stream.",
    tagline: t("Render streaming Markdown in React and Vue. GFM, math and multilingual text, with your own components or Mantine for code highlighting and diagrams."),
    actions: [
      { text: t("Get started"), link: `${docs}guides/getting-started/`, icon: 'right-arrow' },
      { text: t("Try the examples"), link: `${base}${chinese ? 'zh-cn/' : ''}examples/`, variant: 'minimal' },
    ],
  },
}}>
  <div class="home-content not-content">
    <section class="showcase" aria-labelledby="showcase-title">
      <div class="section-intro">
        <p class="eyebrow">{t("01 / FROM TEXT TO INTERFACE")}</p>
        <h2 id="showcase-title">{t("One string. A growing response.")}</h2>
        <p>{t("Append incoming text to one string and pass it to your renderer. Your application handles the connection; AI Markdown handles the content.")}</p>
        <a href={`${docs}guides/streaming-input/`}>{t("Explore streaming \u2192")}</a>
      </div>
      <div class="example-panel">
        <Tabs syncKey="home-framework">
          <TabItem label="React">
            <Code code={reactExample} lang="tsx" />
            <div class="setup-note"><p>{chinese ? "父组件传入当前完整文本和生成状态。安装依赖与框架配置见快速开始。" : "Pass the accumulated text and producer state from your parent component. See the quick start for dependencies and framework setup."}</p><a href={`${docs}guides/react-quick-start/`}>{chinese ? "接入 React →" : "Set up React →"}</a></div>
          </TabItem>
          <TabItem label="Vue">
            <Code code={vueExample} lang="vue" />
            <div class="setup-note"><p>{chinese ? "父组件传入当前完整文本和生成状态。Vue 默认显示流式光标。" : "Pass the accumulated text and producer state from your parent component. Vue shows the streaming cursor by default."}</p><a href={`${docs}guides/vue-quick-start/`}>{chinese ? "接入 Vue →" : "Set up Vue →"}</a></div>
          </TabItem>
        </Tabs>
      </div>
    </section>

    <section class="framework-section" aria-labelledby="framework-title">
      <p class="eyebrow">{t("02 / CHOOSE YOUR STARTING POINT")}</p>
      <h2 id="framework-title">{t("One engine. Your framework.")}</h2>
      <div class="framework-grid">
        <a href={`${docs}guides/react-quick-start/`} class="framework-card"><span class="card-number">@ai-markdown/react</span><h3>React</h3><p>{t("Components, hooks and custom renderers that fit your application.")}</p><span class="card-link">{t("React quick start \u2192")}</span></a>
        <a href={`${docs}guides/vue-quick-start/`} class="framework-card"><span class="card-number">@ai-markdown/vue</span><h3>Vue</h3><p>{t("Reactive props, scoped slots and composables for Vue applications.")}</p><span class="card-link">{t("Vue quick start \u2192")}</span></a>
        <a href={`${docs}guides/react-mantine-quick-start/`} class="framework-card"><span class="card-number">@ai-markdown/react-mantine</span><h3>Mantine <small>{chinese ? "React 集成" : "for React"}</small></h3><p>{t("Theme-aware typography, highlighted code and Mermaid diagrams.")}</p><span class="card-link">{t("Mantine quick start \u2192")}</span></a>
      </div>
    </section>

    <section class="task-section" aria-labelledby="task-title">
      <p class="eyebrow">{chinese ? "03 / 用在你的产品里" : "03 / BUILD YOUR EXPERIENCE"}</p>
      <h2 id="task-title">{chinese ? "从你要做的事开始" : "Start with what you’re building."}</h2>
      <div class="task-grid">
        <article><span class="task-label">01</span><h3>{chinese ? "流式聊天" : "Streaming chat"}</h3><p>{chinese ? "接入持续返回的回答，再按需要添加平滑输出与光标。" : "Render incoming responses, then add smooth output and a streaming cursor."}</p><a href={`${docs}guides/streaming-chat-example/`}>React →</a><a href={`${docs}guides/vue-streaming/`}>Vue →</a></article>
        <article><span class="task-label">02</span><h3>{chinese ? "内容与排版" : "Rich content"}</h3><p>{chinese ? "呈现表格、数学公式与中日韩混排。代码高亮和图表可通过 Mantine 或自定义组件接入。" : "Render tables, math and mixed-language text. Add code highlighting and diagrams with Mantine or custom components."}</p><a href={`${docs}guides/markdown-features/`}>{chinese ? "查看支持的语法 →" : "Explore supported syntax →"}</a></article>
        <article><span class="task-label">03</span><h3>{chinese ? "自己的界面" : "Your own interface"}</h3><p>{chinese ? "替换链接、代码块等元素，调整样式，让 Markdown 融入现有产品。" : "Replace links, code blocks and other elements. Make Markdown feel at home in your product."}</p><a href={`${docs}guides/configuration/`}>{chinese ? "选择配置方式 →" : "Find your configuration →"}</a></article>
      </div>
    </section>

    <section class="closing-cta" aria-labelledby="closing-title"><div><p class="eyebrow">{chinese ? "从一条消息开始" : "START WITH ONE MESSAGE"}</p><h2 id="closing-title">{chinese ? "让下一条回答，呈现得更好。" : "Give your next answer a better home."}</h2></div><a href="#framework-title">{chinese ? "选择框架，开始接入 →" : "Choose your framework →"}</a></section>
    <footer class="home-footer"><span>{t("ai-markdown \u00b7 From the first token to the final footnote.")}</span><a href="https://github.com/ai-markdown/ai-markdown">{t("Meet the project \u2197")}</a></footer>
  </div>
</StarlightPage>

<style>
.home-content { --home-border: var(--sl-color-hairline-light); }
.home-content a { color: var(--sl-color-text-accent); }
.home-content a:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 4px; }
.home-content section { margin-block: 4.5rem; }
.home-content .eyebrow {
  color: var(--sl-color-text-accent);
  font: 600 0.75rem var(--sl-font-mono);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}
.home-content h2 {
  margin-top: 0.75rem;
  font-size: clamp(1.8rem, 3vw, 2.6rem);
  line-height: 1.2;
  letter-spacing: -0.03em;
}
.home-content p { margin-block: 1rem; color: var(--sl-color-gray-2); line-height: 1.75; }
.showcase { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 3.5rem; align-items: center; }
.section-intro { border-inline-start: 2px solid var(--sl-color-accent); padding-inline-start: 1.5rem; }
.section-intro > a { display: inline-block; margin-top: 1.25rem; font-weight: 600; text-decoration: none; }
.example-panel {
  min-width: 0;
  overflow: hidden;
  border: 1px solid var(--home-border);
  border-radius: 0.875rem;
  background: var(--sl-color-bg-nav);
  box-shadow: 0 8px 28px -16px #062a3533;
}
.example-panel :global(.expressive-code) { margin: 0; }
.example-panel :global(.expressive-code pre) { border: 0; border-radius: 0; }
.example-panel :global(.tablist-wrapper) { padding: 1rem 1.25rem; border-bottom: 1px solid var(--home-border); background: var(--sl-color-bg); }
.example-panel :global([role='tablist']) { display: inline-flex; gap: 0.25rem; margin: 0; padding: 0.25rem; border: 1px solid var(--home-border); border-radius: 0.7rem; background: var(--sl-color-bg-nav); }
.example-panel :global(.tab) { margin: 0; }
.example-panel :global([role='tab']) { box-shadow: none; display: flex; align-items: center; justify-content: center; gap: 0.5rem; min-width: 6.5rem; padding: 0.45rem 1rem; border: 1px solid transparent; border-radius: 0.45rem; text-decoration: none; color: var(--sl-color-gray-2); font-size: 0.875rem; font-weight: 600; line-height: 1.5; }
.example-panel :global([role='tab']::before) { content: ''; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: #149eca; }
.example-panel :global(.tab:nth-child(2) [role='tab']::before) { background: #42b883; }
.example-panel :global([role='tab'][aria-selected='true']) { color: var(--sl-color-text); background: var(--sl-color-bg); border-color: var(--home-border); box-shadow: 0 1px 3px #0000000d; }
.example-panel :global([role='tab']:hover) { color: var(--sl-color-text); }
.example-panel :global(.expressive-code .frame) { border: 0; border-radius: 0; box-shadow: none; }
.example-panel :global(.expressive-code .frame pre) { padding-block: 1.25rem; }
.example-panel :global(.expressive-code .frame .header) { display: none; }
.example-panel :global([role='tabpanel']) { margin-top: 0; }
.setup-note { padding: 1rem 1.25rem; border-top: 1px solid var(--home-border); }
.setup-note p { margin: 0 0 0.5rem; font-size: 0.875rem; }
.setup-note a { font-size: 0.875rem; font-weight: 600; }
.framework-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 2rem; }
.framework-card {
  display: flex;
  flex-direction: column;
  padding: 1.75rem;
  border: 1px solid var(--home-border);
  border-top: 3px solid var(--sl-color-accent);
  border-radius: 0.75rem;
  text-decoration: none;
  transition: border-color 150ms ease, background 150ms ease;
}
.framework-card:hover { border-color: var(--sl-color-text-accent); background: var(--sl-color-bg-nav); }
.framework-card:nth-child(2) { border-top-color: #42b883; }
.framework-card:nth-child(3) { border-top-color: #339af0; }
.card-number { font: 0.75rem var(--sl-font-mono); color: var(--sl-color-gray-2); overflow-wrap: anywhere; }
.framework-card h3 { font-size: 1.75rem; margin-block: 1rem 0; }
.framework-card h3 small { display: block; margin-top: 0.25rem; color: var(--sl-color-gray-2); font-size: 0.875rem; font-weight: 400; }
.framework-card p { flex: 1; }
.card-link { color: var(--sl-color-text-accent); font-weight: 600; margin-top: 1rem; }
.task-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; margin-top: 2rem; }
.task-grid article { border-top: 1px solid var(--home-border); padding-top: 1.5rem; }
.task-label { color: var(--sl-color-text-accent); font: 0.75rem var(--sl-font-mono); }
.task-grid h3 { margin-top: 1rem; font-size: 1.25rem; }
.task-grid a { display: inline-block; margin-inline-end: 1rem; font-weight: 600; text-decoration: none; }
.closing-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2rem; padding: clamp(1.5rem, 4vw, 3rem); border-radius: 1rem; background: var(--sl-color-accent-low); }
.closing-cta h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); max-width: 27rem; }
.closing-cta > a { font-weight: 600; text-decoration: none; }
.home-footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-block: 2rem; border-top: 1px solid var(--home-border); color: var(--sl-color-gray-2); font: 0.75rem var(--sl-font-mono); }
.home-content:lang(zh-CN) h2 { letter-spacing: 0; }
@media (max-width: 50rem) {
  .showcase, .framework-grid, .task-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  .showcase { gap: 2rem; }
  .home-content section { margin-block: 3rem; }
}
@media (prefers-reduced-motion: reduce) { .framework-card { transition: none; } }
</style>
