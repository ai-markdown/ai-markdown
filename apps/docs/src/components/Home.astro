---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';
const chinese = Astro.props.chinese === true;
const copy: Record<string, string> = {
  "AI Markdown — Markdown for streaming interfaces": "AI Markdown — 适用于流式界面的 Markdown 渲染库",
  "Render rich Markdown in React and Vue. Built for streaming AI responses, with a shared engine and flexible framework integrations.": "在 React 和 Vue 中渲染 Markdown。支持流式内容追加，可通过 Mantine 或自定义组件接入代码高亮，支持数学公式与中文排版。",
  "Markdown for AI, built for the stream.": "让 AI 回答，边生成边呈现",
  "From the first token to the final response. Rich Markdown for React and Vue, built on one shared engine.": "从第一个字符到完整回答。在 React 与 Vue 中渲染 Markdown，共享同一套解析逻辑。",
  "Get started": "快速开始",
  "Try the examples": "体验交互示例",
  "01 / FROM TEXT TO INTERFACE": "01 / 从文本到界面",
  "One string. A growing response.": "一条消息，持续呈现",
  "Append incoming text to one string and pass it to your renderer. Your application handles the connection; AI Markdown handles the content.": "把收到的文本追加到同一个字符串，再交给渲染组件。应用负责网络连接，AI Markdown 负责内容呈现。",
  "Explore streaming →": "了解流式渲染 →",
  "02 / CHOOSE YOUR STARTING POINT": "02 / 选择你的框架",
  "One engine. Your framework.": "同一套解析，适配你的框架",
  "Components, hooks and custom renderers that fit your application.": "提供组件、Hooks 与自定义渲染能力，方便接入现有应用。",
  "React quick start →": "开始使用 React →",
  "Reactive props, scoped slots and composables for Vue applications.": "为 Vue 应用提供响应式属性、作用域插槽和组合式函数。",
  "Vue quick start →": "开始使用 Vue →",
  "Theme-aware typography, highlighted code and Mermaid diagrams.": "支持 Mantine 主题排版、代码语法高亮与 Mermaid 图表。",
  "Mantine quick start →": "开始使用 Mantine →",
  "ai-markdown · From the first token to the final footnote.": "ai-markdown · 面向流式界面的 Markdown 渲染库",
  "Meet the project ↗": "查看开源项目 ↗"
};
const t = (value: string) => chinese ? (copy[value] ?? value) : value;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = `${base}${chinese ? 'zh-cn/' : ''}docs/`;
const example = `import AIMarkdown, { AIMarkdownStreamingCursor } from '@ai-markdown/react';
import '@ai-markdown/react/typography/default.css';

export function Message({ text, streaming }: { text: string; streaming: boolean }) {
  return (
    <AIMarkdown
      content={text}
      streaming={streaming}
      streamingCursor={AIMarkdownStreamingCursor}
    />
  );
}`;
---

<StarlightPage frontmatter={{
  title: t("AI Markdown \u2014 Markdown for streaming interfaces"),
  description: t("Render rich Markdown in React and Vue. Built for streaming AI responses, with a shared engine and flexible framework integrations."),
  template: 'splash',
  editUrl: false,
  lastUpdated: false,
  pagination: false,
  pagefind: false,
  hero: {
    title: t("Markdown for AI, built for the stream."),
    tagline: t("From the first token to the final response. Rich Markdown for React and Vue, built on one shared engine."),
    actions: [
      { text: t("Get started"), link: `${docs}guides/getting-started/`, icon: 'right-arrow' },
      { text: t("Try the examples"), link: `${base}${chinese ? 'zh-cn/' : ''}examples/`, variant: 'minimal' },
    ],
  },
}}>
  <div class="home-content not-content">
    <section class="showcase" aria-labelledby="showcase-title">
      <div class="section-intro">
        <p class="eyebrow">{t("01 / FROM TEXT TO INTERFACE")}</p>
        <h2 id="showcase-title">{t("One string. A growing response.")}</h2>
        <p>{t("Append incoming text to one string and pass it to your renderer. Your application handles the connection; AI Markdown handles the content.")}</p>
        <a href={`${docs}guides/streaming-input/`}>{t("Explore streaming \u2192")}</a>
      </div>
      <div class="example-panel">
        <div class="panel-label"><span>React</span><span>Message.tsx</span></div>
        <Code code={example} lang="tsx" />
        <div class="setup-note"><p>{chinese ? "示例展示 React 接入方式。安装依赖、样式配置和完整代码见快速开始。" : "This example uses React. Follow the quick start for installation, required styles and the complete setup."}</p><a href={`${docs}guides/react-quick-start/`}>{chinese ? "接入 React →" : "Set up React →"}</a></div>
      </div>
    </section>

    <section class="framework-section" aria-labelledby="framework-title">
      <p class="eyebrow">{t("02 / CHOOSE YOUR STARTING POINT")}</p>
      <h2 id="framework-title">{t("One engine. Your framework.")}</h2>
      <div class="framework-grid">
        <a href={`${docs}guides/react-quick-start/`} class="framework-card"><span class="card-number">@ai-markdown/react</span><h3>React</h3><p>{t("Components, hooks and custom renderers that fit your application.")}</p><span class="card-link">{t("React quick start \u2192")}</span></a>
        <a href={`${docs}guides/vue-quick-start/`} class="framework-card"><span class="card-number">@ai-markdown/vue</span><h3>Vue</h3><p>{t("Reactive props, scoped slots and composables for Vue applications.")}</p><span class="card-link">{t("Vue quick start \u2192")}</span></a>
        <a href={`${docs}guides/react-mantine-quick-start/`} class="framework-card"><span class="card-number">@ai-markdown/react-mantine</span><h3>Mantine</h3><p>{t("Theme-aware typography, highlighted code and Mermaid diagrams.")}</p><span class="card-link">{t("Mantine quick start \u2192")}</span></a>
      </div>
    </section>

    <section class="task-section" aria-labelledby="task-title">
      <p class="eyebrow">{chinese ? "03 / 用在你的产品里" : "03 / BUILD YOUR EXPERIENCE"}</p>
      <h2 id="task-title">{chinese ? "从你要做的事开始" : "Start with what you’re building."}</h2>
      <div class="task-grid">
        <article><span class="task-label">01</span><h3>{chinese ? "流式聊天" : "Streaming chat"}</h3><p>{chinese ? "接入持续返回的回答，再按需要添加平滑输出与光标。" : "Render incoming responses, then add smooth output and a streaming cursor."}</p><a href={`${docs}guides/streaming-chat-example/`}>React →</a><a href={`${docs}guides/vue-streaming/`}>Vue →</a></article>
        <article><span class="task-label">02</span><h3>{chinese ? "内容与排版" : "Rich content"}</h3><p>{chinese ? "呈现表格、数学公式与中日韩混排。代码高亮和图表可通过 Mantine 或自定义组件接入。" : "Render tables, math and mixed-language text. Add code highlighting and diagrams with Mantine or custom components."}</p><a href={`${docs}guides/markdown-features/`}>{chinese ? "查看支持的语法 →" : "Explore supported syntax →"}</a></article>
        <article><span class="task-label">03</span><h3>{chinese ? "自己的界面" : "Your own interface"}</h3><p>{chinese ? "替换链接、代码块等元素，调整样式，让 Markdown 融入现有产品。" : "Replace links, code blocks and other elements. Make Markdown feel at home in your product."}</p><a href={`${docs}guides/configuration/`}>{chinese ? "选择配置方式 →" : "Find your configuration →"}</a></article>
      </div>
    </section>

    <section class="closing-cta" aria-labelledby="closing-title"><div><p class="eyebrow">{chinese ? "从一条消息开始" : "START WITH ONE MESSAGE"}</p><h2 id="closing-title">{chinese ? "让下一条回答，呈现得更好。" : "Give your next answer a better home."}</h2></div><a href={`${docs}guides/getting-started/`}>{chinese ? "选择框架，开始接入 →" : "Choose your framework →"}</a></section>
    <footer class="home-footer"><span>{t("ai-markdown \u00b7 From the first token to the final footnote.")}</span><a href="https://github.com/ai-markdown">{t("Meet the project \u2197")}</a></footer>
  </div>
</StarlightPage>

<style>
.home-content a:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 4px; }
.home-content a {
  color: var(--sl-color-text-accent);
}
.home-content {
  --home-border: var(--sl-color-hairline-light);
}
.home-content section {
  margin-block: 5rem;
}
.showcase {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap: 3rem;
  align-items: center;
}
.home-content .eyebrow {
  color: var(--sl-color-text-accent);
  font-size: 0.875rem;
  font-weight: 600;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}
.home-content h2 {
  margin-top: 0.75rem;
  font-size: clamp(1.8rem, 3vw, 2.6rem);
  line-height: 1.2;
  letter-spacing: -0.03em;
}
.home-content p {
  margin-block: 1rem;
  color: var(--sl-color-gray-2);
  line-height: 1.75;
}
.section-intro > a {
  display: inline-block;
  margin-top: 1.25rem;
  font-weight: 600;
  text-decoration: none;
}
.example-panel {
  overflow: hidden;
  border: 1px solid var(--home-border);
  border-radius: 1rem;
  background: var(--sl-color-bg-nav);
}
.panel-label {
  display: flex;
  justify-content: space-between;
  padding: 0.875rem 1.25rem;
  font-family: var(--sl-font-mono);
  font-size: 0.875rem;
  border-bottom: 1px solid var(--home-border);
}
.example-panel :global(.expressive-code) {
  margin: 0;
}
.example-panel :global(.expressive-code pre) {
  border: 0;
  border-radius: 0;
}
.framework-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-top: 2rem;
}
.framework-card {
  display: flex;
  flex-direction: column;
  padding: 1.75rem;
  border: 1px solid var(--home-border);
  border-radius: 0.75rem;
  text-decoration: none;
  color: var(--sl-color-text);
}
.framework-card:hover {
  border-color: var(--sl-color-text-accent);
  background: var(--sl-color-bg-nav);
}
.card-number {
  font-family: var(--sl-font-mono);
  font-size: 0.8125rem;
  color: var(--sl-color-gray-2);
}
.framework-card h3 {
  font-size: 1.75rem;
  margin-block: 1.5rem 0;
}
.framework-card p {
  flex: 1;
}
.card-link {
  color: var(--sl-color-text-accent);
  font-weight: 600;
  margin-top: 1rem;
}
.home-footer {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
  padding-block: 2rem;
  border-top: 1px solid var(--home-border);
  font-size: 0.875rem;
  color: var(--sl-color-gray-2);
}
@media (max-width: 50rem) {
  .showcase,
  .framework-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .home-content section {
    margin-block: 3rem;
  }
}

.home-content section {
  margin-block: 4.5rem;
}
.home-content .eyebrow {
  font-family: var(--sl-font-mono);
  font-size: 0.75rem;
  letter-spacing: 0.1em;
}
.showcase {
  grid-template-columns: 0.8fr 1.2fr;
  gap: 3.5rem;
}
.section-intro {
  border-inline-start: 2px solid var(--sl-color-accent);
  padding-inline-start: 1.5rem;
}
.example-panel {
  box-shadow: 0 18px 55px -30px #062a354d;
}
.panel-label {
  background: var(--sl-color-accent-low);
}
.framework-card {
  border-radius: 0.75rem;
  border-top: 3px solid var(--sl-color-accent);
  transition:
    border-color 150ms ease,
    background 150ms ease;
}
.framework-card:nth-child(2) {
  border-top-color: #42b883;
}
.framework-card:nth-child(3) {
  border-top-color: #339af0;
}
.framework-card .card-number {
  font-size: 0.75rem;
  overflow-wrap: anywhere;
}
.framework-card h3 {
  margin-top: 1rem;
}
.home-footer {
  font-family: var(--sl-font-mono);
  font-size: 0.75rem;
}
@media (max-width: 50rem) {
  .showcase {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
}
.setup-note { padding: 1rem 1.25rem; border-top: 1px solid var(--home-border); }
.setup-note p { margin: 0 0 0.5rem; font-size: 0.875rem; }
.setup-note a { font-size: 0.875rem; font-weight: 600; }
.task-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; margin-top: 2rem; }
.task-grid article { border-top: 1px solid var(--home-border); padding-top: 1.5rem; }
.task-label { color: var(--sl-color-text-accent); font: 0.75rem var(--sl-font-mono); }
.task-grid h3 { margin-top: 1rem; font-size: 1.25rem; }
.task-grid a { display: inline-block; margin-inline-end: 1rem; font-weight: 600; text-decoration: none; }
.closing-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2rem; padding: clamp(1.5rem, 4vw, 3rem); border-radius: 1rem; background: var(--sl-color-accent-low); }
.closing-cta h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); max-width: 27rem; }
.closing-cta > a { font-weight: 600; text-decoration: none; }
@media (max-width: 50rem) { .task-grid { grid-template-columns: 1fr; gap: 1.5rem; } }
@media (prefers-reduced-motion: reduce) {
  .framework-card {
    transition: none;
  }
}
</style>
