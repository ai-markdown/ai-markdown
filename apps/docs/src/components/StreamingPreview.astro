---
const { chinese = false } = Astro.props;
---

<streaming-preview data-pause={chinese ? '暂停演示' : 'Pause demo'} data-play={chinese ? '继续播放' : 'Resume demo'} data-running={chinese ? '正在播放' : 'Playing'} data-paused={chinese ? '已暂停' : 'Paused'}>
  <div class="preview-content"><div class="preview-source"><slot /></div></div>
  <div class="preview-controls"><button type="button" hidden>{chinese ? '暂停演示' : 'Pause demo'}</button><span class="preview-status" role="status"></span></div>
</streaming-preview>

<script>
  class StreamingPreview extends HTMLElement {
    connectedCallback() {
      this.cleanup?.();
      const source = this.querySelector<HTMLElement>('.preview-source')!;
      const content = this.querySelector<HTMLElement>('.preview-content')!;
      const button = this.querySelector<HTMLButtonElement>('button')!;
      const status = this.querySelector<HTMLElement>('.preview-status')!;
      const visual = source.cloneNode(true) as HTMLElement;
      visual.className = 'preview-animation';
      visual.setAttribute('aria-hidden', 'true');
      const walker = document.createTreeWalker(visual, NodeFilter.SHOW_TEXT);
      const nodes: Text[] = [];
      while (walker.nextNode()) nodes.push(walker.currentNode as Text);
      const chars: HTMLSpanElement[] = [];
      const segmenter = new Intl.Segmenter(undefined, { granularity: 'grapheme' });
      for (const node of nodes) {
        if (!node.textContent?.trim()) continue;
        const fragment = document.createDocumentFragment();
        for (const { segment } of segmenter.segment(node.textContent)) {
          const char = document.createElement('span');
          char.textContent = segment;
          char.className = 'preview-char';
          chars.push(char);
          fragment.append(char);
        }
        node.replaceWith(fragment);
      }
      const items = [...visual.querySelectorAll('li')].map((item) => {
        item.classList.add('preview-item');
        return { item, first: chars.indexOf(item.querySelector('.preview-char') as HTMLSpanElement) };
      });
      content.append(visual);
      this.classList.add('enhanced');
      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      let index = 0;
      let paused = false;
      let visible = false;
      let timer: ReturnType<typeof setTimeout> | undefined;
      const clear = () => { clearTimeout(timer); timer = undefined; };
      const paint = () => {
        items.forEach(({ item, first }) => item.classList.toggle('revealed', first >= 0 && first < index));
        chars.forEach((char, i) => {
          char.classList.toggle('shown', i < index);
          char.classList.toggle('caret', i === index - 1 && index < chars.length);
        });
      };
      const schedule = () => {
        clear();
        button.hidden = motion.matches;
        const label = paused ? this.dataset.play! : this.dataset.pause!;
        if (button.textContent !== label) button.textContent = label;
        if (button.getAttribute('aria-label') !== label) button.setAttribute('aria-label', label);
        this.dataset.state = paused ? 'paused' : 'playing';
        const statusText = motion.matches ? '' : paused ? this.dataset.paused! : this.dataset.running!;
        if (status.textContent !== statusText) status.textContent = statusText;
        status.hidden = motion.matches;
        if (motion.matches) {
          index = chars.length;
          paint();
          return;
        }
        if (paused || !visible || document.hidden) return;
        timer = setTimeout(() => {
          index = index === chars.length ? 0 : index + 1;
          paint();
          schedule();
        }, index === chars.length ? 2600 : index === 0 ? 650 : 55);
      };
      const toggle = () => { paused = !paused; schedule(); };
      const observer = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        schedule();
      }, { threshold: 0.15 });
      button.addEventListener('click', toggle);
      document.addEventListener('visibilitychange', schedule);
      motion.addEventListener('change', schedule);
      observer.observe(this);
      paint();
      schedule();
      this.cleanup = () => {
        clear();
        observer.disconnect();
        button.removeEventListener('click', toggle);
        document.removeEventListener('visibilitychange', schedule);
        motion.removeEventListener('change', schedule);
        visual.remove();
        this.classList.remove('enhanced');
        button.hidden = true;
        status.textContent = '';
      };
    }
    cleanup?: () => void;
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('streaming-preview')) customElements.define('streaming-preview', StreamingPreview);
</script>

<style is:global>
streaming-preview { display: block; }
streaming-preview .preview-content { display: grid; }
streaming-preview .preview-source,
streaming-preview .preview-animation { grid-area: 1 / 1; min-width: 0; }
streaming-preview.enhanced .preview-source { opacity: 0; pointer-events: none; }
streaming-preview .preview-item { visibility: hidden; }
streaming-preview .preview-item.revealed { visibility: visible; }
streaming-preview .preview-controls { display: flex; align-items: center; gap: 0.8rem; margin-top: 1rem; min-height: 2.25rem; }
streaming-preview .preview-status { font-size: 0.75rem; color: inherit; opacity: 0.8; }
streaming-preview .preview-char { visibility: hidden; position: relative; }
streaming-preview .preview-char.shown { visibility: visible; }
streaming-preview .preview-char.caret::after {
  content: '';
  position: absolute;
  inset-inline-start: 100%;
  top: 0.1em;
  width: 0.13em;
  height: 1em;
  background: var(--sl-color-text-accent);
}
streaming-preview button {
  margin: 0;
  min-width: 8.5rem;
  min-height: 2.25rem;
  padding: 0.35rem 0.75rem;
  border: 1px solid var(--sl-color-hairline-light);
  border-radius: 0.3rem;
  background: transparent;
  color: var(--sl-color-text-accent);
  font: inherit;
  font-size: 0.8125rem;
  cursor: pointer;
}
streaming-preview button::before { content: 'Ⅱ'; display: inline-block; width: 1rem; margin-inline-end: 0.35rem; }
streaming-preview[data-state='paused'] button::before { content: '▶'; }
streaming-preview button:hover { background: var(--sl-color-bg); }
streaming-preview button:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 3px; }
streaming-preview button[hidden] { display: none; }
</style>
